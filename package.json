{
  "name": "cosmo",
  "type": "module",
  "private": true,
  "author": "ditta",
  "scripts": {
    "sb:login": "storyblok login",
    "sb:logout": "storyblok logout",
    "sb:help": "storyblok --help",
    "sb:components": "storyblok components pull --space 292521441604089 --verbose",
    "sb:types": "storyblok types generate --space 292521441604089 --strict",
    "sb:generate": "npm run sb:components && npm run sb:types",
    "create:favicons": "npx nuxt-seo-utils icons --source ./favicon.svg",
    "agent:readability": "npx @vercel/agent-readability audit https://cosmo-app.com",
    "dev": "npm run sb:generate && nuxt dev --host 0.0.0.0",
    "dev:ssl": "local-ssl-proxy --source 3010 --target 3000 --cert localhost.pem --key localhost-key.pem",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "nuke": "del-cli '.output' 'dist' '.nuxt' 'node_modules' 'package-lock.json'",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxtjs/seo": "^5.1.3",
    "@storyblok/nuxt": "^10.1.7",
    "@tailwindcss/vite": "^4.3.0",
    "@takumi-rs/core": "^1.3.0",
    "nuxt": "^4.4.6",
    "postcss-nested": "^7.0.2",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/image": "^2.0.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^25.9.0",
    "better-sqlite3": "^12.10.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "nuxt-ai-ready": "^1.3.7",
    "storyblok": "^4.17.7",
    "tailwind-merge": "^3.6.0",
    "typescript": "^6.0.3",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-svg-loader": "^5.1.1"
  }
}
